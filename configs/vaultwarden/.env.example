# Copy to .env and replace every value. Never commit .env.

# Public URL of the instance
DOMAIN=https://vault.example.com

# The admin token lives in vw-data/config.json as an Argon2 hash, not here.
# Generate one with: docker exec -it vaultwarden /vaultwarden hash
# If you prefer env-based config, remove admin_token from config.json and set:
# ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$CHANGEME$CHANGEME'
